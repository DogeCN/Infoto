{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    // `playwright.config.ts` reads MEDIA_HOST_URL through the repo-root `scripts/dev-config.mjs`,
    // so the dev scripts and the Worker cannot disagree about the local media host's port.
    // JSDoc types on that file are what the import resolves to.
    "allowJs": true,
    "noEmit": true,
    "paths": {
      "$shared/*": ["../src/shared/*"],
      "$base/*": ["./src/base/*"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["src/**/*.svelte"]
}
