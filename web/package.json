{
  "name": "infoto-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Infoto SPA (built into ../dist, served by the Worker ASSETS binding)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ts-check": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "ci": "npm run ts-check && npm run test && npm run e2e"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.47.0",
    "@playwright/test": "^1.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.10.0",
    "clsx": "^2.1.1",
    "fake-indexeddb": "^6.0.0",
    "svelte": "^5.15.0",
    "svelte-check": "^4.1.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.11.0",
    "markdown-it": "^15.0.2",
    "mediabunny": "^1.0.0",
    "tailwind-variants": "^3.3.1"
  }
}
