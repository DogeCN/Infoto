# Environment variables for local tooling. Copy to `.env` and fill in your own values; the
# real file is gitignored. Nothing in the repository reads this file at runtime — CI and the
# deploy workflow take the same names as GitHub secrets and variables, and `wrangler dev` reads
# `.dev.vars` instead (see `.dev.vars.example`). This file exists so a shell can source the
# credentials that `wrangler` and `gh` expect in the environment.

# Cloudflare API token with Workers Scripts + D1 edit rights, and the account it belongs to.
# Used by `npx wrangler deploy` outside CI, and by the D1 commands in `npm run db:* --remote`.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Personal access token used by `gh` for release notes and tag pushes.
GITHUB_TOKEN=

# Turnstile keys for a local deployment against your own account. For plain local dev these are
# not needed at all: `.dev.vars.example` already holds Cloudflare's published always-pass test
# pair, and the deploy workflow injects the real secret from GitHub on a tag push.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=