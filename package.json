{
  "name": "infoto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Full-stack shared photo album deployed on Cloudflare Workers",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run db:local && npm run dev:worker\" \"npm run wait:worker && npm run dev -w infoto-web\"",
    "dev:worker": "node --use-system-ca node_modules/wrangler/bin/wrangler.js dev --port 8787",
    "wait:worker": "node scripts/wait-for-worker.mjs",
    "build": "npm run build -w infoto-web",
    "db:local": "node scripts/db-local.mjs",
    "db:reset": "node scripts/reset-local-db.mjs",
    "gen-schema": "node scripts/gen-schema-ddl.mjs",
    "test": "vitest run && npm test -w infoto-web",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "ts-check": "tsc -p tsconfig.worker.json && tsc -p tsconfig.local.json && tsc -p tsconfig.test.json && npm run ts-check -w infoto-web"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9",
    "wrangler": "^4.141.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "workerd@1.20260925.1": true
  }
}
