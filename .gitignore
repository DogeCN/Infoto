.env
.dev.vars
node_modules/
.data/
# Local wrangler dev state (D1 local sqlite, caches).
.wrangler/
# Parallel-party coordination scratch (not source; never commit).
.workbuddy/
# Build output — generated by the deploy workflow (and local `npm run build`).
dist/
.trae/
# CodeBuddy IDE / plan metadata (not source; never committed).
.codebuddy/
# Local editor config (tasks, launch, settings) — never committed.
.vscode/
.svelte-check/
web/test-results/
test-results/
# Wrangler --outdir build scratch (regenerated per dry run).
.tmp-worker-build/
# Playwright / Vite run-time temp scripts (regenerated per run; not source).
**/.tmp-*
