.env
!.env.example
# Wrangler's dev-vars convention: the local file is gitignored, the tracked template is not.
.dev.vars*
!.dev.vars.example
node_modules/
.data/
# Local wrangler dev state (D1 local sqlite, caches).
.wrangler/
# Build output — generated by the deploy workflow (and local `npm run build`).
dist/
# Tool-private agent memory (not project knowledge — see .agents/).
.trae/
.workbuddy/
# Local editor config (tasks, launch, settings) — never committed.
.vscode/
.svelte-check/
web/test-results/
test-results/
# Uploads accepted by the local media-host stand-in (`scripts/local-media-host.mjs`).
.local-media/
.tmp-*

# Facade source stays local-only since the v0.1.2 history rewrite
media-proxy/
